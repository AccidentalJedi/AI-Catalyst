{
  "name": "ai-catalyst-launch-wizard",
  "version": "1.0.0",
  "description": "Automated wizard for launching mission-driven AI education platforms",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "server:start": "cd server && npm run start",
    "server:check": "cd server && npm run check",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "install:all": "npm install && cd server && npm install",
    "build:all": "npm run build && npm run server:build",
    "setup": "npm run install:all && npm run setup:env",
    "setup:env": "node -e \"const fs=require('fs'); if(!fs.existsSync('server/.env')){fs.existsSync('server/.env.example')?fs.copyFileSync('server/.env.example','server/.env'):fs.writeFileSync('server/.env','JWT_SECRET=dev-secret\\nPORT=3001\\nNODE_ENV=development\\nDATABASE_PATH=./data/ai-catalyst.db\\n')}\"",
    "start": "npm run dev:full",
    "postinstall": "cd server && npm install"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-hook-form": "^7.48.0",
    "zustand": "^4.4.0",
    "@chakra-ui/react": "^2.8.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "framer-motion": "^10.16.0",
    "react-icons": "^4.12.0",
    "date-fns": "^4.1.0",
    "yup": "^1.4.0",
    "@hookform/resolvers": "^3.3.0",
    "crypto-js": "^4.2.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.9.0",
    "@types/crypto-js": "^4.2.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "typescript": "^5.2.0",
    "vite": "^4.5.0",
    "vitest": "^1.0.0",
    "jsdom": "^23.0.0",
    "@vitest/ui": "^1.0.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/user-event": "^14.5.0",
    "concurrently": "^8.2.0",
    "prettier": "^3.1.0"
  },
  "keywords": [
    "business-formation",
    "ai-education",
    "social-enterprise",
    "veteran-business",
    "automation",
    "wizard"
  ],
  "author": "AI Catalyst Project",
  "license": "MIT"
}
