{
  "name": "ai-catalyst-backend",
  "version": "1.0.0",
  "description": "AI Catalyst Launch Wizard Backend API",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --exec \"node -r tsconfig-paths/register -r ts-node/register src/index.ts\"",
    "build": "tsc && node scripts/setup-aliases.js",
    "start": "node -r ./dist/module-aliases.js dist/index.js",
    "watch": "tsc --watch",
    "check": "ts-node -r tsconfig-paths/register scripts/check-config.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:docusign": "jest --testPathPatterns=docusignService",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/handlebars": "^4.0.40",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^2.30.0",
    "docusign-esign": "^6.4.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.1.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "html2canvas": "^1.4.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.0",
    "jspdf": "^2.5.0",
    "module-alias": "^2.2.3",
    "multer": "^1.4.5-lts.1",
    "natural": "^6.12.0",
    "node-cron": "^3.0.0",
    "nodemailer": "^6.9.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^21.6.0",
    "tesseract.js": "^5.0.0",
    "winston": "^3.11.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/crypto-js": "^4.2.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.0",
    "@vitest/ui": "^3.2.4",
    "jest": "^30.0.4",
    "jest-junit": "^16.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.4",
    "nodemon": "^3.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "_moduleAliases": {
    "@config": "dist/config",
    "@controllers": "dist/controllers",
    "@middleware": "dist/middleware",
    "@models": "dist/models",
    "@routes": "dist/routes",
    "@services": "dist/services",
    "@utils": "dist/utils",
    "@types": "dist/types",
    "@templates": "dist/templates"
  },
  "keywords": [
    "ai-catalyst",
    "backend",
    "api",
    "express",
    "typescript"
  ],
  "author": "AI Catalyst Team",
  "license": "MIT"
}
