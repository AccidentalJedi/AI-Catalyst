{
  "name": "ai-catalyst-backend",
  "version": "1.0.0",
  "description": "AI Catalyst Launch Wizard Backend API",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --exec \"node -r tsconfig-paths/register -r ts-node/register src/index.ts\"",
    "build": "tsc && node scripts/setup-aliases.js",
    "start": "node -r ./dist/module-aliases.js dist/index.js",
    "watch": "tsc --watch",
    "check": "ts-node -r tsconfig-paths/register scripts/check-config.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:docusign": "jest --testPathPatterns=docusignService",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:postgresql": "TEST_DATABASE_TYPE=postgresql jest",
    "test:postgresql:watch": "TEST_DATABASE_TYPE=postgresql jest --watch",
    "test:postgresql:coverage": "TEST_DATABASE_TYPE=postgresql jest --coverage",
    "test:sqlite": "TEST_DATABASE_TYPE=sqlite jest",
    "test:sqlite:watch": "TEST_DATABASE_TYPE=sqlite jest --watch",
    "test:sqlite:coverage": "TEST_DATABASE_TYPE=sqlite jest --coverage",
    "test:integration": "jest --testPathPatterns=integration",
    "db:migrate:latest": "node_modules\\.bin\\knex migrate:latest --knexfile ../knexfile.cjs",
    "db:migrate:up": "node_modules\\.bin\\knex migrate:up --knexfile ../knexfile.cjs",
    "db:migrate:down": "node_modules\\.bin\\knex migrate:down --knexfile ../knexfile.cjs",
    "db:backup": "ts-node -r tsconfig-paths/register scripts/backup.ts",
    "db:backup:create": "ts-node -r tsconfig-paths/register scripts/backup.ts create",
    "db:backup:list": "ts-node -r tsconfig-paths/register scripts/backup.ts list",
    "db:backup:cleanup": "ts-node -r tsconfig-paths/register scripts/backup.ts cleanup",
    "db:rollback": "ts-node -r tsconfig-paths/register scripts/rollback.ts",
    "db:rollback:last": "ts-node -r tsconfig-paths/register scripts/rollback.ts last",
    "db:rollback:version": "ts-node -r tsconfig-paths/register scripts/rollback.ts version",
    "db:rollback:backup": "ts-node -r tsconfig-paths/register scripts/rollback.ts backup",
    "db:status": "ts-node -r tsconfig-paths/register scripts/migrationStatus.ts status",
    "db:status:json": "ts-node -r tsconfig-paths/register scripts/migrationStatus.ts json",
    "db:migrate:data": "ts-node -r tsconfig-paths/register scripts/migrateData.ts",
    "db:migrate:data:clean": "ts-node -r tsconfig-paths/register scripts/migrateData.ts --clean-destination",
    "test:migration-setup": "ts-node -r tsconfig-paths/register scripts/testMigrationSetup.ts",
    "db:migrate:data:dry-run": "ts-node -r tsconfig-paths/register scripts/dataMigration.ts migrate -- --dry-run",
    "db:verify:integrity": "ts-node -r tsconfig-paths/register scripts/dataIntegrityCheck.ts",
    "db:seed": "node_modules\\.bin\\knex seed:run --knexfile ../knexfile.cjs",
    "db:seed:make": "node_modules\\.bin\\knex seed:make --knexfile ../knexfile.cjs",
    "db:fresh": "npm run db:migrate:down && npm run db:migrate:latest && npm run db:seed",
    "db:validate": "ts-node -r tsconfig-paths/register scripts/validateDatabaseConfig.ts",
    "db:validate:knex": "ts-node -r tsconfig-paths/register scripts/validateKnexSystem.ts",
    "test:user-service": "ts-node -r tsconfig-paths/register scripts/testUserService.ts",
    "test:auth-service": "ts-node -r tsconfig-paths/register scripts/testAuthService.ts",
    "perf:load:light": "ts-node -r tsconfig-paths/register scripts/loadTesting.ts light",
    "perf:load:medium": "ts-node -r tsconfig-paths/register scripts/loadTesting.ts medium",
    "perf:load:heavy": "ts-node -r tsconfig-paths/register scripts/loadTesting.ts heavy",
    "perf:load:production": "ts-node -r tsconfig-paths/register scripts/loadTesting.ts production",
    "perf:backup:test": "ts-node -r tsconfig-paths/register scripts/backupRecoveryTest.ts",
    "deploy:production": "bash scripts/deploy.sh deploy",
    "deploy:rollback": "bash scripts/deploy.sh rollback",
    "deploy:status": "bash scripts/deploy.sh status",
    "deploy:health": "bash scripts/deploy.sh health",
    "docker:build": "docker build -f Dockerfile.production -t ai-catalyst-app:latest .",
    "docker:up": "docker-compose -f docker-compose.production.yml up -d",
    "docker:down": "docker-compose -f docker-compose.production.yml down",
    "docker:logs": "docker-compose -f docker-compose.production.yml logs -f"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/handlebars": "^4.0.40",
    "@types/pg": "^8.15.4",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^2.30.0",
    "docusign-esign": "^6.4.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.1.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "html2canvas": "^1.4.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.0",
    "knex": "^3.1.0",
    "module-alias": "^2.2.3",
    "multer": "^1.4.5-lts.1",
    "natural": "^6.12.0",
    "node-cron": "^3.0.0",
    "nodemailer": "^6.9.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "puppeteer": "^21.6.0",
    "sqlite3": "^5.1.7",
    "tesseract.js": "^5.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.11.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/crypto-js": "^4.2.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^6.4.0",
    "@vitest/ui": "^3.2.4",
    "jest": "^30.0.4",
    "jest-junit": "^16.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.4",
    "nodemon": "^3.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "_moduleAliases": {
    "@config": "dist/config",
    "@controllers": "dist/controllers",
    "@middleware": "dist/middleware",
    "@models": "dist/models",
    "@routes": "dist/routes",
    "@services": "dist/services",
    "@utils": "dist/utils",
    "@types": "dist/types",
    "@templates": "dist/templates"
  },
  "keywords": [
    "ai-catalyst",
    "backend",
    "api",
    "express",
    "typescript"
  ],
  "author": "AI Catalyst Team",
  "license": "MIT"
}
